<?xml version="1.0" encoding="utf-8"?>
<!-- Het platform draait thuis vaak op http in het eigen netwerk (poort 80 zonder domein): dat mag.
     Met een domein gebruik je https. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
