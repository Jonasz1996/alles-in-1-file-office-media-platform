{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Platform",
  "version": "0.1.0",
  "identifier": "org.platform.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Platform",
        "width": 1280,
        "height": 820,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "Bestanden synchroniseren en media kijken",
    "longDescription": "De desktop-app van het platform: dezelfde web-app (bestanden, foto's, media met de speler) in een eigen venster, en een map van deze computer die op de achtergrond met het platform gelijk blijft.",
    "category": "Utility",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Dutch",
          "English"
        ]
      }
    }
  }
}