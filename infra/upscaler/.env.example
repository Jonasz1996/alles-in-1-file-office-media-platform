# Het adres van het platform zoals deze node het bereikt, in het eigen netwerk over http (poort
# 80): het IP-adres van de VIP van het cluster. Een adres met https werkt alleen met een geldig
# certificaat (een domein).
PLATFORM_URL=http://192.168.10.146
# Van /beheer → Media → AI-upscaling → "Token voor de upscaler maken"
UPSCALER_TOKEN=
# realesr-animevideov3 (snel, goed voor video) of realesrgan-x4plus (trager)
UPSCALER_MODEL=realesr-animevideov3
UPSCALER_GPU=0
UPSCALER_WORK_DIR=./work
