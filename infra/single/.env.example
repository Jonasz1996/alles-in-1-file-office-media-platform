# Voorbeeld; install.sh maakt /opt/platform/.env.
DATA_ROOT=/tank/platform
NODE_NAME=node1
PORT=80
HTTPS_PORT=443
SECURE_COOKIES=false

# Office (OnlyOffice Docs, fase 4). aan of uit; curl … | OFFICE=uit bash zet het uit.
OFFICE=aan
# Twee eigen geheimen voor office, elk 64 hex-tekens. Leeg laten: install.sh vult ze, en
# vervangt een bestaande waarde nooit (dan blijven de tokens en opslaglinks van DS geldig).
OFFICE_JWT_SECRET=
OFFICE_LINK_SECRET=
# Een pin: zet hier een image van DS (met digest) om bij dat image te blijven, bijvoorbeeld om
# terug te rollen. Neem een naam uit RepoDigests van dat image (docs/runbooks/office.md); die
# vindt Docker ook zonder internet. install.sh gebruikt hem zoals hij is, haalt dan geen nieuw
# image en gooit hem nooit weg. Zonder pin: de digest die install.sh kent.
# OFFICE_IMAGE=onlyoffice/documentserver@sha256:ca17889f10b11141cc6441836aebdd2835cf3e1b49681b2fd6e155c94b7850b3
