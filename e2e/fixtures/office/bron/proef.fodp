<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
  xmlns:presentation="urn:oasis:names:tc:opendocument:xmlns:presentation:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.presentation">
 <office:meta>
  <dc:title>Proefpresentatie</dc:title>
  <meta:initial-creator>Platform e2e</meta:initial-creator>
 </office:meta>
 <office:automatic-styles>
  <style:page-layout style:name="PM1">
   <style:page-layout-properties fo:page-width="28cm" fo:page-height="15.75cm" style:print-orientation="landscape"/>
  </style:page-layout>
  <style:style style:name="P1" style:family="paragraph">
   <style:text-properties fo:font-size="32pt" fo:font-weight="bold"/>
  </style:style>
  <style:style style:name="P2" style:family="paragraph">
   <style:text-properties fo:font-size="20pt"/>
  </style:style>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Standaard" style:page-layout-name="PM1"/>
 </office:master-styles>
 <office:body>
  <office:presentation>
   <draw:page draw:name="Dia1" draw:master-page-name="Standaard">
    <draw:frame svg:x="2cm" svg:y="2cm" svg:width="24cm" svg:height="3cm">
     <draw:text-box><text:p text:style-name="P1">Proefpresentatie van het platform</text:p></draw:text-box>
    </draw:frame>
    <draw:frame svg:x="2cm" svg:y="6cm" svg:width="24cm" svg:height="6cm">
     <draw:text-box><text:p text:style-name="P2">Eerste dia, voor de tests van office.</text:p></draw:text-box>
    </draw:frame>
   </draw:page>
   <draw:page draw:name="Dia2" draw:master-page-name="Standaard">
    <draw:frame svg:x="2cm" svg:y="2cm" svg:width="24cm" svg:height="3cm">
     <draw:text-box><text:p text:style-name="P1">Tweede dia</text:p></draw:text-box>
    </draw:frame>
    <draw:frame svg:x="2cm" svg:y="6cm" svg:width="24cm" svg:height="6cm">
     <draw:text-box><text:p text:style-name="P2">Samen bewerken en een voorbeeld zonder de editor.</text:p></draw:text-box>
    </draw:frame>
   </draw:page>
  </office:presentation>
 </office:body>
</office:document>
