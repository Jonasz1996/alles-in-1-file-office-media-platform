<?xml version="1.0" encoding="UTF-8"?>
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:table="urn:oasis:names:tc:opendocument:xmlns:table:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta>
  <dc:title>Proefdocument</dc:title>
  <meta:initial-creator>Platform e2e</meta:initial-creator>
 </office:meta>
 <office:styles>
  <style:default-style style:family="paragraph">
   <style:paragraph-properties fo:margin-bottom="0.2cm"/>
   <style:text-properties style:font-name="Liberation Serif" fo:font-size="12pt" fo:language="nl" fo:country="NL"/>
  </style:default-style>
  <style:style style:name="Heading_20_1" style:display-name="Heading 1" style:family="paragraph">
   <style:text-properties fo:font-size="18pt" fo:font-weight="bold"/>
  </style:style>
 </office:styles>
 <office:body>
  <office:text>
   <text:h text:style-name="Heading_20_1" text:outline-level="1">Proefdocument van het platform</text:h>
   <text:p>Dit is de eerste alinea van het proefdocument. Hij staat hier voor de tests van office.</text:p>
   <text:p>Tweede alinea: samen bewerken, opslaan als nieuwe versie en een voorbeeld zonder de editor.</text:p>
   <table:table table:name="Tabel1">
    <table:table-column table:number-columns-repeated="2"/>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>Soort</text:p></table:table-cell>
     <table:table-cell office:value-type="string"><text:p>Aantal</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>Appels</text:p></table:table-cell>
     <table:table-cell office:value-type="float" office:value="3"><text:p>3</text:p></table:table-cell>
    </table:table-row>
    <table:table-row>
     <table:table-cell office:value-type="string"><text:p>Peren</text:p></table:table-cell>
     <table:table-cell office:value-type="float" office:value="5"><text:p>5</text:p></table:table-cell>
    </table:table-row>
   </table:table>
   <text:p>Laatste alinea van het proefdocument.</text:p>
  </office:text>
 </office:body>
</office:document>
